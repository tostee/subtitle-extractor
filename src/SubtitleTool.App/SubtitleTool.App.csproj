<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Subtitulos</AssemblyName>
    <RootNamespace>SubtitleTool.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Subtítulos</Product>
    <ApplicationIcon>Assets\Subtitulos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SubtitleTool.App.Tests" />
    <!-- Los usings implícitos de WPF no incluyen System.IO. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Subtitulos.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubtitleTool.Core\SubtitleTool.Core.csproj" />
  </ItemGroup>

</Project>
