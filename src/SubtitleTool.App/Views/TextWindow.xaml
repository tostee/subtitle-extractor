<Window x:Class="SubtitleTool.App.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=sys:String}"
        Width="820" Height="480" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}"
        FocusManager.FocusedElement="{Binding ElementName=ContentBox}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Solo lectura, pero con cursor visible: se puede recorrer y seleccionar con el teclado -->
        <TextBox x:Name="ContentBox" Text="{Binding Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Button Grid.Row="1" Content="Cerrar" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0" />
    </Grid>
</Window>
