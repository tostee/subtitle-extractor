<Window x:Class="SubtitleTool.App.Views.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SubtitleTool.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GlossaryEditorViewModel}"
        Title="{Binding Title}" Width="980" Height="680" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding GlossaryPath}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="Términos (personajes, lugares, expresiones)" Style="{StaticResource SectionHeader}" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Terms}" CanUserAddRows="True" CanUserDeleteRows="True" RowHeight="NaN"
                  MinRowHeight="28" SelectionUnit="CellOrRowHeader" HeadersVisibility="All" RowHeaderWidth="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Inglés" Binding="{Binding En, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridTextColumn Header="Español" Binding="{Binding Es, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" ElementStyle="{StaticResource EditorCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Tratamiento entre personajes (A habla a B de tú o de usted)" Style="{StaticResource SectionHeader}" Margin="0,14,0,8" />
        <DataGrid Grid.Row="4" ItemsSource="{Binding Address}" CanUserAddRows="True" CanUserDeleteRows="True" RowHeight="NaN"
                  MinRowHeight="28" SelectionUnit="CellOrRowHeader" HeadersVisibility="All" RowHeaderWidth="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="A" Binding="{Binding A, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridTextColumn Header="B" Binding="{Binding B, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridComboBoxColumn Header="Forma" Width="110"
                                        ItemsSource="{x:Static vm:GlossaryEditorViewModel.Forms}"
                                        SelectedItemBinding="{Binding Form, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" ElementStyle="{StaticResource EditorCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Regenerar…" Command="{Binding RegenerateCommand}" Margin="0,0,6,0"
                        ToolTip="Vuelve a generar el glosario con Claude (backend y modelo actuales) y reemplaza este." />
                <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,6,0" />
                <Button Content="Cerrar" IsCancel="True" MinWidth="90" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
