<Window x:Class="SubtitleTool.App.Views.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SubtitleTool.App.ViewModels"
        xmlns:views="clr-namespace:SubtitleTool.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GlossaryEditorViewModel}"
        Title="{Binding Title}" Width="980" Height="680" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}" Closing="OnClosing"
        FocusManager.FocusedElement="{Binding ElementName=TermsGrid}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding GlossaryPath}" Style="{StaticResource TrimmedText}" Foreground="{DynamicResource MutedText}" Margin="0,0,0,12" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Agregar _término" Command="{Binding AddTermCommand}" Margin="0,0,8,0" />
                <Button Content="_Quitar término" Command="{Binding RemoveTermCommand}"
                        ToolTip="Quita el término seleccionado (también con Supr sobre la fila)." />
            </StackPanel>
            <Label x:Name="TermsLabel" Content="Términos (personajes, lugares, e_xpresiones)" Target="{Binding ElementName=TermsGrid}"
                   FontSize="14" FontWeight="SemiBold" />
        </DockPanel>
        <DataGrid x:Name="TermsGrid" Grid.Row="2" ItemsSource="{Binding Terms}" CanUserAddRows="True" CanUserDeleteRows="True" RowHeight="NaN"
                  MinRowHeight="32" SelectionUnit="FullRow" SelectedItem="{Binding SelectedTerm}"
                  IsReadOnly="{Binding IsBusy}"
                  AutomationProperties.LabeledBy="{Binding ElementName=TermsLabel}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Inglés" Binding="{Binding En, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridTextColumn Header="Español" Binding="{Binding Es, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" ElementStyle="{StaticResource EditorCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,16,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Agregar tr_atamiento" Command="{Binding AddAddressCommand}" Margin="0,0,8,0" />
                <Button Content="Q_uitar tratamiento" Command="{Binding RemoveAddressCommand}"
                        ToolTip="Quita el tratamiento seleccionado (también con Supr sobre la fila)." />
            </StackPanel>
            <Label x:Name="AddressLabel" Content="Trata_miento entre personajes (A habla a B de tú o de usted)" Target="{Binding ElementName=AddressGrid}"
                   FontSize="14" FontWeight="SemiBold" />
        </DockPanel>
        <DataGrid x:Name="AddressGrid" Grid.Row="4" ItemsSource="{Binding Address}" CanUserAddRows="True" CanUserDeleteRows="True" RowHeight="NaN"
                  MinRowHeight="32" SelectionUnit="FullRow" SelectedItem="{Binding SelectedAddress}"
                  IsReadOnly="{Binding IsBusy}"
                  AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Personaje A (habla)" Binding="{Binding A, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridTextColumn Header="Personaje B (escucha)" Binding="{Binding B, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource EditorCellText}" />
                <DataGridComboBoxColumn Header="Forma" Width="110"
                                        ItemsSource="{x:Static vm:GlossaryEditorViewModel.Forms}"
                                        SelectedItemBinding="{Binding Form, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" ElementStyle="{StaticResource EditorCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <DockPanel>
                    <views:StatusIcon DockPanel.Dock="Left" Kind="{Binding StatusKind}" VerticalAlignment="Top" Margin="0,2,6,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                </DockPanel>
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="4" Margin="0,6,0,0"
                             AutomationProperties.Name="Generando glosario"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar generación" Command="{Binding CancelRegenerateCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Content="_Regenerar…" Command="{Binding RegenerateCommand}" Click="OnCommitEdits" Margin="0,0,8,0"
                        ToolTip="Vuelve a generar el glosario con Claude (modo de traducción y modelo actuales) y reemplaza este." />
                <Button Content="_Guardar" Command="{Binding SaveCommand}" Click="OnCommitEdits" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Cerrar" IsCancel="True" MinWidth="90" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
